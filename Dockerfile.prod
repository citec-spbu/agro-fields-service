# Multi-stage сборка Spring Boot: позволяет CI/локально билдить образ без mvn на хосте.
# Текущий Dockerfile ожидает уже собранный target/*.jar — здесь это делается в первом стейдже.

FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /workspace

COPY pom.xml ./
# Кешируем зависимости отдельно, чтобы пересборка кода не тянула maven repo каждый раз.
RUN mvn -B -ntp dependency:go-offline

COPY src ./src
RUN mvn -B -ntp -DskipTests clean package

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /workspace/target/*.jar fields.jar

EXPOSE 8080
ENTRYPOINT ["java", "-XX:+ExitOnOutOfMemoryError", "-jar", "/app/fields.jar"]
